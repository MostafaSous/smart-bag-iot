#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// ─── WiFi Credentials ───────────────────────────────────────────────────────
#define WIFI_SSID     "Your_WiFi_SSID"
#define WIFI_PASSWORD "Your_WiFi_Password"

// ─── MQTT Credentials ───────────────────────────────────────────────────────
#define MQTT_HOST     "your-hivemq-host.hivemq.cloud"
#define MQTT_PORT     8883
#define MQTT_USER     "your-mqtt-username"
#define MQTT_PASS     "your-mqtt-password"
#define MQTT_CLIENT_ID "bagA"

// ─── TLS/SSL Certificate (for MQTT) ─────────────────────────────────────────
// Download your CA certificate from HiveMQ and paste it here
// Or use: const char* ca_cert = nullptr; to skip verification (NOT RECOMMENDED)
const char* ca_cert = R"EOF(
-----BEGIN CERTIFICATE-----
YOUR_CA_CERTIFICATE_HERE
-----END CERTIFICATE-----
)EOF";

#endif // CREDENTIALS_H
